<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="cat.moltpadel.desktop.controller.AdminController" fx:id="borderId" prefWidth="1280" prefHeight="720">

    <left>
        <VBox spacing="15" prefWidth="200">
            <Label text="MoltPadel"/>
            <Button text="Inici" onAction="#inici" prefWidth="150"/>
            <Button text="Gestió de pistes" onAction="#pistes" prefWidth="150"/>
            <Button text="Gestió d'usuaris" onAction="#usuaris" prefWidth="150"/>
            <Button text="Reserves" onAction="#reserves" prefWidth="150"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Tanca sessió" onAction="#tancarSessio" prefWidth="150"/>
        </VBox>
    </left>

    <center>
        <VBox fx:id="boxId" spacing="15">
            <Label text="Administració"/>
            <Label text="Benvingut al panell de control d'administració"/>
        </VBox>
    </center>

</BorderPane>
