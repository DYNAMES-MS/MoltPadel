<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="cat.moltpadel.desktop.controller.ConfirmarReservaController" spacing="15">

    <Label text="Confirmar reserva"/>
    <Label fx:id="franjaId"/>

    <Label text="Pistes interiors"/>
    <FlowPane fx:id="interiorsId" hgap="10" vgap="10"/>

    <Label text="Pistes exteriors"/>
    <FlowPane fx:id="exteriorsId" hgap="10" vgap="10"/>

    <Separator/>

    <Label text="Resum de la reserva"/>
    <Label fx:id="pistaId" text="Selecciona una pista"/>
    <Label fx:id="tipusId"/>
    <Label fx:id="preuId"/>

    <Label fx:id="missatgeId" wrapText="true"/>

    <HBox spacing="10">
        <Button fx:id="tornarBotoId" text="Tornar a disponibilitat" onAction="#tornarDisponibilitat"/>
        <Button fx:id="confirmarBotoId" text="Confirmar reserva" onAction="#confirmarReserva" disable="true"/>
    </HBox>

</VBox>