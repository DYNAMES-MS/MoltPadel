<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="cat.moltpadel.desktop.controller.ConfirmarReservaController" styleClass="pantalla-reserva">

    <Label text="Confirmar reserva" styleClass="titol-principal"/>
    <Label fx:id="franjaId" styleClass="missatge"/>

    <Label text="Pistes interiors" styleClass="titol-secundari"/>
    <FlowPane fx:id="interiorsId" hgap="10" vgap="10"/>

    <Label text="Pistes exteriors" styleClass="titol-secundari"/>
    <FlowPane fx:id="exteriorsId" hgap="10" vgap="10"/>

    <Separator/>

    <Label text="Resum de la reserva" styleClass="titol-secundari"/>
    <Label fx:id="pistaId" text="Selecciona una pista" styleClass="missatge"/>
    <Label fx:id="tipusId" styleClass="missatge"/>
    <Label fx:id="preuId" styleClass="missatge"/>

    <Label fx:id="missatgeId" wrapText="true" styleClass="missatge"/>

    <HBox spacing="10">
        <Button fx:id="tornarBotoId" text="Tornar a disponibilitat" onAction="#tornarDisponibilitat" styleClass="boto-secundari"/>
        <Button fx:id="confirmarBotoId" text="Confirmar reserva" onAction="#confirmarReserva" disable="true" styleClass="boto-principal"/>
    </HBox>

</VBox>