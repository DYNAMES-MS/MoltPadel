<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="gestioId" xmlns:fx="http://javafx.com/fxml" fx:controller="cat.moltpadel.desktop.controller.GestioPistesController" styleClass="pantalla-gestio">
    <Label text="Gestió de pistes" styleClass="titol-principal"/>

    <HBox spacing="10">
        <Button text="Crear pista" onAction="#crearPista" styleClass="boto-principal"/>
        <Button fx:id="editarBotoId" text="Editar pista" onAction="#editarPista" styleClass="boto-secundari"/>
        <Button fx:id="estatBotoId" text="Canviar l'estat" onAction="#canviarEstat" styleClass="boto-secundari"/>
    </HBox>

    <Label fx:id="missatgeId" styleClass="missatge"/>

    <TableView fx:id="taulaPistesId" prefHeight="500">
        <columns>
            <TableColumn fx:id="idColumna" text="ID" prefWidth="50"/>
            <TableColumn fx:id="nomColumna" text="Nom" prefWidth="250"/>
            <TableColumn fx:id="tipusColumna" text="Tipus" prefWidth="150"/>
            <TableColumn fx:id="estatColumna" text="Estat" prefWidth="150"/>
        </columns>
    </TableView>

</VBox>
