<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="cat.moltpadel.desktop.controller.IniciController" prefWidth="1280" prefHeight="720">

    <VBox alignment="CENTER" spacing="15" maxWidth="400" maxHeight="-Infinity">
        <Label text="Benvingut a MoltPadel"/>
        <Button fx:id="sessioBotoId" text="Inicia sessió" onAction="#obrirSessio" prefWidth="250"/>
        <Button text="Consulta les pistes" prefWidth="250"/>
    </VBox>

</StackPane>
