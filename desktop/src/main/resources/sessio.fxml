<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="cat.moltpadel.desktop.controller.SessioController" prefWidth="1280" prefHeight="720">

        <VBox alignment="CENTER" spacing="15" maxWidth="400" maxHeight="-Infinity" style="-fx-border-color: black; -fx-border-width: 1; -fx-border-radius: 10; -fx-padding: 25;">
        <Label text="MoltPadel" />
        <Label text="Inicia sessió" />
        <TextField fx:id="emailId" promptText="Correu electrònic" onAction="#iniciarSessio" maxWidth="250"/>
        <PasswordField fx:id="contrasenyaId" promptText="Contrasenya" onAction="#iniciarSessio" maxWidth="250"/>
        <Button fx:id="entraBotoId" text="Entra" onAction="#iniciarSessio" maxWidth="250"/>
        <Label fx:id="errorId" wrapText="true" maxWidth="250" alignment="CENTER"/>
        <Button text="Torna a l'inici" onAction="#tornarInici" maxWidth="100"/>
    </VBox>

</StackPane>


