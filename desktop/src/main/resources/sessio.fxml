<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="cat.moltpadel.desktop.controller.SessioController" styleClass="pantalla-formulari" prefWidth="1280" prefHeight="720">

    <VBox fx:id="formulariId" styleClass="formulari" alignment="CENTER" maxWidth="400" maxHeight="-Infinity">
        <Label text="MoltPadel" styleClass="nom-app"/>
        <Label text="Inicia sessió" styleClass="titol-principal"/>
        <TextField fx:id="emailId" promptText="Correu electrònic" onAction="#iniciarSessio" maxWidth="250"/>
        <PasswordField fx:id="contrasenyaId" promptText="Contrasenya" onAction="#iniciarSessio" maxWidth="250"/>
        <Button fx:id="entraBotoId" text="Entra" onAction="#iniciarSessio" styleClass="boto-principal" maxWidth="250"/>
        <Button text="Has oblidat la contrasenya?" onAction="#recuperacio" styleClass="boto-text" maxWidth="250"/>
        <Label fx:id="errorId" styleClass="missatge" wrapText="true" maxWidth="250"/>
        <Button text="Torna a l'inici" styleClass="boto-secundari" onAction="#tornarInici" maxWidth="100"/>
    </VBox>

</StackPane>