<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="cat.moltpadel.desktop.controller.SociController" spacing="15">
    <Label text="Soci de MoltPadel"/>

    <Label fx:id="estatId"/>
    <Label fx:id="tipusId"/>
    <Label fx:id="iniciId"/>
    <Label fx:id="fiId"/>

    <Label text="Quota mensual: 99€ - Quota anual: 1.100€"/>
    <Label text="Fent-te soci, pots tenir fins a 3 reserves actives per 0€"/>

    <HBox spacing="10">
        <Button fx:id="mensualBotoId" text="Activar mensual" onAction="#activarMensual" disable="true"/>
        <Button fx:id="anualBotoId" text="Activar anual" onAction="#activarAnual" disable="true"/>
    </HBox>

    <Label fx:id="missatgeId" wrapText="true"/>
</VBox>