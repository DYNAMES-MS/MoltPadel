<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="cat.moltpadel.desktop.controller.UsuariController" fx:id="borderId" prefWidth="1280" prefHeight="720">

    <left>
        <VBox spacing="15" prefWidth="230">
            <Label text="MoltPadel"/>
            <Button text="Inici" onAction="#inici" prefWidth="150"/>
            <Button text="Consulta les pistes" onAction="#disponibilitat" prefWidth="150"/>
            <Button text="Reserves" onAction="#reservesUsuari" prefWidth="150"/>
            <Button text="Soci" onAction="#soci" prefWidth="150"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Tanca sessió" onAction="#tancarSessio" prefWidth="150"/>
        </VBox>
    </left>

    <center>
        <VBox fx:id="boxId" spacing="15">
            <Label text="Benvingut!"/>
            <Label text="Consulta i reserva pistes"/>
        </VBox>
    </center>

</BorderPane>